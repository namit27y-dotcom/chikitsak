# CHIKITSAK Backend Configuration
APP_NAME="CHIKITSAK API"
APP_ENV=development
API_V1_PREFIX=/api/v1

# MySQL 8 Connection (set your real credentials in backend/.env)
DATABASE_URL=mysql+pymysql://chikitsak_user:CHANGE_ME@localhost:3306/chikitsak

# JWT Authentication (generate a strong random secret in production)
JWT_SECRET_KEY=CHANGE_ME_USE_STRONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Google Gemini API (server-side only, never expose to frontend)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Private Upload Storage & Limits
UPLOAD_DIR=storage/uploads
MAX_UPLOAD_SIZE_MB=10
TESSERACT_CMD=

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173
