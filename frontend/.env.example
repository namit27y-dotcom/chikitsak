# CHIKITSAK Frontend Environment Variables

# FastAPI backend /api/v1 base URL.
# Leave blank to run the frontend in standalone/demo mode without a backend.
# Local development example:
#   VITE_API_BASE_URL="http://localhost:8000/api/v1"
# Production backend example:
#   VITE_API_BASE_URL="https://your-chikitsak-api.example.com/api/v1"
VITE_API_BASE_URL=""

# Optional: Vite dev server proxy target for local development if using relative /api/v1
# VITE_DEV_PROXY_TARGET="http://127.0.0.1:8000"
